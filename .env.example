# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env. On Vercel, set these in the project's Environment Variables.
# Everything defaults to "fake" / "memory", so the app runs with no keys at all.

# --- Storage ---
# memory   = load data/sample/pairs.tsv into memory at startup (no database)
# postgres = use DATABASE_URL (local Docker or Neon)
STORE=memory
DATABASE_URL=postgresql://lingo:lingo@localhost:5432/lingo

# --- Embedding ---
# fake | openai_compatible  (any provider with an OpenAI-style /embeddings endpoint)
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the model's output dimension; changing it means re-creating the table.
# 1024 for the fake embedder (fewer hash collisions than smaller sizes).
EMBEDDING_DIM=1024

# --- LLM ---
# fake | anthropic | openai_compatible
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Retrieval ---
# Examples scoring below this are dropped; if none remain, the answer is marked
# "grounded: false" (AI-generated, no real evidence). 0 disables the filter.
# 0.15 is tuned for the fake embedder at dim 1024 on the sample data only.
# Re-tune with real data after switching to a real embedding model.
MIN_RELEVANCE_SCORE=0.15

# --- API ---
# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
