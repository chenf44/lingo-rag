# Copy to .env for local development:  cp .env.example .env
# NEVER commit .env. On Vercel, set these in the project's Environment Variables.
# Everything defaults to "fake" / "memory", so the app runs with no keys at all.

# --- Storage ---
# memory   = load data/sample/pairs.tsv into memory at startup (no database)
# postgres = use DATABASE_URL (local Docker or Neon)
STORE=memory
DATABASE_URL=postgresql://lingo:lingo@localhost:5432/lingo

# --- Embedding ---
# fake | openai_compatible  (any provider with an OpenAI-style /embeddings endpoint)
EMBEDDING_PROVIDER=fake
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the model's output dimension; changing it means re-creating the table.
EMBEDDING_DIM=256

# --- LLM ---
# fake | anthropic | openai_compatible
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- API ---
# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
